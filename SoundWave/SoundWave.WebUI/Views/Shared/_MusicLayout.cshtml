<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | SoundWave</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        },
                        animation: {
                            'pulse-slow': 'pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        }
                    }
                }
            }
    </script>

    <style>
            body {
                background-color: #07090E;
                overflow-x: hidden;
            }

            .glass-nav {
                background: rgba(11, 15, 25, 0.82);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .glass-card {
                background: rgba(17, 22, 34, 0.72);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.08);
            }

            .gradient-text {
                background: linear-gradient(135deg, #A855F7 0%, #EC4899 50%, #06B6D4 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .btn-gradient {
                background: linear-gradient(135deg, #7C3AED 0%, #DB2777 55%, #0891B2 100%);
                background-size: 200% auto;
                transition: all 0.4s ease;
            }

                .btn-gradient:hover {
                    background-position: right center;
                    box-shadow: 0 0 25px rgba(219, 39, 119, 0.45);
                }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen text-slate-100 pb-20 relative selection:bg-fuchsia-500 selection:text-white">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-40 left-1/4 w-[32rem] h-[32rem] bg-purple-600/20 rounded-full blur-[140px] animate-pulse-slow"></div>
        <div class="absolute top-1/3 -right-32 w-[28rem] h-[28rem] bg-cyan-500/15 rounded-full blur-[140px] animate-pulse-slow"></div>
        <div class="absolute bottom-0 left-10 w-96 h-96 bg-pink-600/15 rounded-full blur-[140px] animate-pulse-slow"></div>
    </div>

    @await Component.InvokeAsync("_MusicLayoutNavbar")

    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20">
        @RenderBody()
    </main>

    <footer class="relative z-10 text-center text-xs text-slate-600 mt-16">
        MyAcademy SoundWave • Hakları Saklıdır • @DateTime.Now.Year
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>