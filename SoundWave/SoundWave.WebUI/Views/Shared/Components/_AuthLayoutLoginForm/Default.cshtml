@using SoundWave.DTO.AuthDtos
@model LoginDto

<div class="col-span-1 lg:col-span-6 p-8 sm:p-12 flex flex-col justify-center">

    <div class="flex lg:hidden items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-pink-500 to-cyan-400 flex items-center justify-center">
            <i class="fa-solid fa-wave-square text-white text-lg"></i>
        </div>
        <span class="text-2xl font-extrabold text-white">Sound<span class="gradient-text">Wave</span></span>
    </div>

    <div class="mb-7">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Tekrar Hoş Geldin</h2>
        <p class="text-slate-400 text-sm mt-1.5">Hesabına giriş yap ve abonelik paketindeki şarkıları dinlemeye başla.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-5 p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-start gap-2.5">
            <i class="fa-solid fa-circle-exclamation text-rose-400 mt-0.5 text-sm"></i>
            <div asp-validation-summary="All" class="space-y-1"></div>
        </div>
    }

    <form asp-controller="Auth" asp-action="Login" method="post" class="space-y-5">
        <div>
            <label asp-for="UserNameOrEmail" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                Kullanıcı Adı veya E-Posta
            </label>
            <div class="relative group">
                <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 group-focus-within:text-pink-400 transition-colors">
                    <i class="fa-regular fa-envelope"></i>
                </span>
                <input asp-for="UserNameOrEmail" id="usernameInput" type="text" required
                       placeholder="ornek@soundwave.com"
                       class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500/60 focus:ring-2 focus:ring-pink-500/20 transition-all" />
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between mb-2">
                <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
                    Şifre
                </label>
                <a href="#" class="text-xs font-medium text-cyan-400 hover:text-cyan-300 transition-colors">Şifremi Unuttum?</a>
            </div>
            <div class="relative group">
                <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 group-focus-within:text-purple-400 transition-colors">
                    <i class="fa-solid fa-lock"></i>
                </span>
                <input asp-for="Password" id="passwordInput" type="password" required
                       placeholder="••••••••"
                       class="w-full pl-11 pr-11 py-3.5 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-purple-500/60 focus:ring-2 focus:ring-purple-500/20 transition-all" />
                <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-200 transition-colors">
                    <i id="eyeIcon" class="fa-regular fa-eye"></i>
                </button>
            </div>
        </div>
        <button type="submit" class="w-full py-3.5 px-6 rounded-xl font-bold text-sm text-white btn-gradient shadow-lg flex items-center justify-center gap-2 cursor-pointer">
            <span>Giriş Yap</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
    </form>

    <p class="text-center text-xs text-slate-400 mt-6">
        Henüz bir SoundWave hesabın yok mu?
        <a asp-controller="Auth" asp-action="Register" class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-cyan-400 hover:underline ml-1">
            Paket Seç ve Kayıt Ol
        </a>
    </p>
</div>
