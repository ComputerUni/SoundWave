@using SoundWave.Entity.Enums
@model SoundWave.DTO.SelectPlanDtos.SelectPlanDto

@{
    SubscriptionLevel currentPlan = ViewBag.CurrentLevel != null ? (SubscriptionLevel)ViewBag.CurrentLevel : Model.SubscriptionLevel;
    SubscriptionLevel selectedPlan = Model?.SubscriptionLevel ?? SubscriptionLevel.Free;

}

<main class="relative z-10 max-w-6xl w-full mx-auto my-auto">

    <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-cyan-300 mb-4">
            <i class="fa-solid fa-sliders text-pink-400"></i> Ses Kalitesi & Erişim Yetkisi
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Sana Uygun <span class="gradient-text">Ses Deneyimini</span> Seç
        </h1>
        <p class="text-slate-400 text-sm sm:text-base mt-3">
            Seçtiğin abonelik seviyesi JWT yetki anahtarına anında tanımlanır. Üst paketler, alt paketlerin tüm arşivine sınırsız erişim sağlar.
        </p>
    </div>

    <form asp-controller="Auth" asp-action="SelectPlan" method="post" id="planForm">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">

            <label class="cursor-pointer block relative group">
                <input type="radio" name="SubscriptionLevel" value="@SubscriptionLevel.Free" checked="@(selectedPlan == SubscriptionLevel.Free ? "checked" : null)" data-theme="free" class="plan-radio sr-only" />
                <div class="plan-card h-full rounded-3xl p-6 glass-card border border-white/10 flex flex-col justify-between relative">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="px-3 py-1 rounded-lg bg-slate-800 text-slate-300 text-xs font-bold border border-white/10">
                                SEVİYE 1
                            </span>
                            <span class="check-circle opacity-0 scale-75 transition-all duration-300 w-7 h-7 rounded-full bg-slate-200 text-slate-950 flex items-center justify-center shadow-lg">
                                <i class="fa-solid fa-check text-xs"></i>
                            </span>
                        </div>

                        <h3 class="text-xl font-extrabold text-white">Free</h3>
                        <p class="text-xs text-slate-400 mt-1">Başlangıç seviyesi müzik keyfi</p>

                        <div class="my-5 pb-5 border-b border-white/10">
                            <span class="text-3xl font-extrabold text-white">₺0</span>
                            <span class="text-xs text-slate-400"> / ay</span>
                        </div>

                        <ul class="space-y-3 text-xs text-slate-300">
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-slate-400"></i>
                                <span><strong>64 kbps</strong> standart ses kalitesi</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-slate-400"></i>
                                <span>Seviye 1 genel şarkı arşivi</span>
                            </li>
                            <li class="flex items-center gap-2.5 text-slate-500">
                                <i class="fa-solid fa-volume-low"></i>
                                <span>Reklam destekli dinleme</span>
                            </li>
                            <li class="flex items-center gap-2.5 text-slate-600 line-through">
                                <i class="fa-solid fa-xmark"></i>
                                <span>Klipler & Stüdyo FLAC</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-6 pt-4 border-t border-white/5 text-center">
                        <span class="text-xs font-bold text-slate-400 group-hover:text-white transition-colors">Free ile Devam Et</span>
                    </div>
                </div>
            </label>

            <label class="cursor-pointer block relative group">
                <input type="radio" name="SubscriptionLevel" value="@SubscriptionLevel.Standard" checked="@(selectedPlan == SubscriptionLevel.Standard ? "checked" : null)" data-theme="standard" class="plan-radio sr-only" />
                <div class="plan-card h-full rounded-3xl p-6 glass-card border border-cyan-500/20 flex flex-col justify-between relative">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="px-3 py-1 rounded-lg bg-cyan-500/15 text-cyan-300 text-xs font-bold border border-cyan-500/30">
                                SEVİYE 2
                            </span>
                            <span class="check-circle opacity-0 scale-75 transition-all duration-300 w-7 h-7 rounded-full bg-cyan-400 text-slate-950 flex items-center justify-center shadow-lg">
                                <i class="fa-solid fa-check text-xs"></i>
                            </span>
                        </div>

                        <h3 class="text-xl font-extrabold text-cyan-300">Standard</h3>
                        <p class="text-xs text-slate-400 mt-1">Kesintisiz, reklamsız dinleme</p>

                        <div class="my-5 pb-5 border-b border-white/10">
                            <span class="text-3xl font-extrabold text-white">₺59.90</span>
                            <span class="text-xs text-slate-400"> / ay</span>
                        </div>

                        <ul class="space-y-3 text-xs text-slate-300">
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-cyan-400"></i>
                                <span><strong>128 kbps</strong> net ses kalitesi</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-cyan-400"></i>
                                <span>Tamamen <strong>reklamsız</strong> deneyim</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-cyan-400"></i>
                                <span>Seviye 1 + Seviye 2 tüm içerikler</span>
                            </li>
                            <li class="flex items-center gap-2.5 text-slate-600 line-through">
                                <i class="fa-solid fa-xmark"></i>
                                <span>320 kbps + Video Klipler</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-6 pt-4 border-t border-white/5 text-center">
                        <span class="text-xs font-bold text-cyan-400 group-hover:text-cyan-300 transition-colors">Standard Seç</span>
                    </div>
                </div>
            </label>

            <label class="cursor-pointer block relative group">
                <input type="radio" name="SubscriptionLevel" value="@SubscriptionLevel.Premium" checked="@(selectedPlan == SubscriptionLevel.Premium ? "checked" : null)" data-theme="premium" class="plan-radio sr-only" />
                <div class="plan-card h-full rounded-3xl p-6 glass-card border-2 border-pink-500/40 flex flex-col justify-between relative">

                    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full btn-gradient text-[10px] font-extrabold uppercase tracking-wider text-white shadow-lg">
                        En Popüler
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-4 mt-1">
                            <span class="px-3 py-1 rounded-lg bg-fuchsia-500/15 text-fuchsia-300 text-xs font-bold border border-fuchsia-500/30">
                                SEVİYE 3
                            </span>
                            <span class="check-circle opacity-0 scale-75 transition-all duration-300 w-7 h-7 rounded-full bg-fuchsia-500 text-white flex items-center justify-center shadow-lg">
                                <i class="fa-solid fa-check text-xs"></i>
                            </span>
                        </div>

                        <h3 class="text-xl font-extrabold text-fuchsia-300">Premium</h3>
                        <p class="text-xs text-slate-400 mt-1">Yüksek bit hızı ve özel klipler</p>

                        <div class="my-5 pb-5 border-b border-white/10">
                            <span class="text-3xl font-extrabold text-white">₺99.90</span>
                            <span class="text-xs text-slate-400"> / ay</span>
                        </div>

                        <ul class="space-y-3 text-xs text-slate-300">
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-fuchsia-400"></i>
                                <span><strong>320 kbps</strong> yüksek ses kalitesi</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-fuchsia-400"></i>
                                <span>Özel <strong>HD Video Klipler</strong></span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-fuchsia-400"></i>
                                <span>Seviye 1, 2 ve 3 tam erişim</span>
                            </li>
                            <li class="flex items-center gap-2.5 text-slate-600 line-through">
                                <i class="fa-solid fa-xmark"></i>
                                <span>Kayıpsız FLAC & Stüdyo</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-6 pt-4 border-t border-white/5 text-center">
                        <span class="text-xs font-bold text-fuchsia-400 group-hover:text-fuchsia-300 transition-colors">Premium Seç</span>
                    </div>
                </div>
            </label>

            <label class="cursor-pointer block relative group">
                <input type="radio" name="SubscriptionLevel" value="@SubscriptionLevel.Diamond" checked="@(selectedPlan == SubscriptionLevel.Diamond ? "checked" : null)" data-theme="diamond" class="plan-radio sr-only" />
                <div class="plan-card h-full rounded-3xl p-6 glass-card border border-amber-500/30 bg-gradient-to-b from-amber-500/[0.06] to-transparent flex flex-col justify-between relative">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="px-3 py-1 rounded-lg bg-amber-500/15 text-amber-300 text-xs font-bold border border-amber-500/35 flex items-center gap-1.5">
                                <i class="fa-solid fa-gem text-[10px]"></i> SEVİYE 4
                            </span>
                            <span class="check-circle opacity-0 scale-75 transition-all duration-300 w-7 h-7 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center shadow-lg">
                                <i class="fa-solid fa-check text-xs"></i>
                            </span>
                        </div>

                        <h3 class="text-xl font-extrabold text-amber-300">Diamond</h3>
                        <p class="text-xs text-slate-400 mt-1">Odyofiller için kayıpsız stüdyo sesi</p>

                        <div class="my-5 pb-5 border-b border-white/10">
                            <span class="text-3xl font-extrabold text-white">₺149.90</span>
                            <span class="text-xs text-slate-400"> / ay</span>
                        </div>

                        <ul class="space-y-3 text-xs text-slate-300">
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-amber-400"></i>
                                <span><strong>Hi-Fi FLAC</strong> kayıpsız ses</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-amber-400"></i>
                                <span><strong>Stüdyo Özel</strong> kayıtlar & demo</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-amber-400"></i>
                                <span>Platformdaki <strong>tüm seviyelere</strong> erişim</span>
                            </li>
                            <li class="flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-check text-amber-400"></i>
                                <span>Özel Diamond profil rozeti</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-6 pt-4 border-t border-white/5 text-center">
                        <span class="text-xs font-bold text-amber-400 group-hover:text-amber-300 transition-colors">Diamond Seç</span>
                    </div>
                </div>
            </label>

        </div>

        <div class="max-w-md mx-auto text-center">
            <button type="submit" id="submitBtn" class="w-full py-4 px-8 rounded-2xl font-extrabold text-sm text-white btn-gradient shadow-xl flex items-center justify-center gap-3 cursor-pointer">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span id="submitBtnText">@selectedPlan Paket ile Keşfetmeye Başla</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
            <p class="text-[11px] text-slate-500 mt-3">
                <i class="fa-solid fa-shield-halved text-cyan-400 mr-1"></i>
                Seçiminiz anında JWT token içerisine işlenir ve güvenli oturum başlatılır
            </p>
        </div>
    </form>
</main>