@model SoundWave.DTO.ArtistDtos.ArtistDetailDto

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_MusicLayout.cshtml";

    var artistImg = string.IsNullOrEmpty(Model.ImageUrl)
        ? "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=800&q=85"
        : Model.ImageUrl;
}

<style>
    @@keyframes pulseAura {
        0%, 100% { transform: scale(1); opacity: 0.45; }
        50% { transform: scale(1.06); opacity: 0.8; }
    }

    .artist-aura {
        animation: pulseAura 4s ease-in-out infinite;
    }
</style>

<div class="relative w-full min-h-[calc(100vh-135px)] rounded-[2rem] overflow-hidden border border-white/10 p-6 sm:p-10 lg:p-12 shadow-[0_25px_90px_-15px_rgba(0,0,0,0.85)]">

    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <img src="@artistImg" alt=""
             class="w-full h-full object-cover scale-125 blur-[95px] opacity-30 saturate-150" />
        <div class="absolute inset-0 bg-gradient-to-br from-[#090b14]/92 via-[#0d1021]/85 to-[#080a12]/95"></div>
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-pink-600/20 blur-[110px]"></div>
        <div class="absolute top-1/3 -right-24 w-[28rem] h-[28rem] rounded-full bg-cyan-500/20 blur-[120px]"></div>
    </div>
    <partial name="Partials/_ArtistDetailTopBarPartial" />
    <partial name="Partials/_ArtistDetailHeroPartial" model="Model" />
    <partial name="Partials/_ArtistDetailDiscographyPartial" model="Model" />
</div>

<script>
    function toggleAlbum(albumId) {
        const body = document.getElementById(`album-body-${albumId}`);
        const icon = document.getElementById(`album-icon-${albumId}`);

        if (!body || !icon) return;

        body.classList.toggle("hidden");
        icon.classList.toggle("rotate-180");
    }
</script>