@using SoundWave.Entity.Enums
@model SoundWave.DTO.ArtistDtos.ArtistDetailDto

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_MusicLayout.cshtml";
    int userLevel = ViewBag.UserLevel ?? 1;
    var artistImg = string.IsNullOrEmpty(Model.ImageUrl)
        ? "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&q=80"
        : Model.ImageUrl;
}

<div class="max-w-6xl mx-auto space-y-8 pb-12">

    <div>
        <a asp-controller="Music" asp-action="Discover"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-semibold text-slate-300 transition-all">
            <i class="fa-solid fa-arrow-left text-pink-400"></i>
            <span>Keşfet'e Dön</span>
        </a>
    </div>

    <div class="relative rounded-3xl glass-card border border-white/10 p-6 sm:p-10 overflow-hidden">
        <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-pink-500/15 blur-[90px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-cyan-500/15 blur-[90px] pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8">
            <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-3xl overflow-hidden border-2 border-pink-500/40 shadow-[0_0_40px_rgba(236,72,153,0.25)] shrink-0">
                <img src="@artistImg" alt="@Model.Name" class="w-full h-full object-cover" />
            </div>

            <div class="flex-1 text-center md:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/15 border border-pink-500/30 text-pink-300 text-xs font-bold mb-3">
                    <i class="fa-solid fa-microphone-lines"></i> Doğrulanmış Sanatçı
                </div>

                <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-3">
                    @Model.Name
                </h1>

                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="text-sm sm:text-base text-slate-300/90 leading-relaxed max-w-3xl mb-5">
                        @Model.Bio
                    </p>
                }

                <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 text-xs text-slate-300">
                    <span class="px-3.5 py-1.5 rounded-xl bg-white/[0.06] border border-white/10">
                        <i class="fa-solid fa-compact-disc text-pink-400 mr-1.5"></i>
                        <strong>@(Model.Albums?.Count ?? 0)</strong> Albüm
                    </span>
                    <span class="px-3.5 py-1.5 rounded-xl bg-white/[0.06] border border-white/10">
                        <i class="fa-solid fa-music text-cyan-400 mr-1.5"></i>
                        <strong>@(Model.Albums?.Sum(a => a.Songs?.Count ?? 0) ?? 0)</strong> Şarkı
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        <h2 class="text-xl font-extrabold text-white flex items-center gap-2.5 px-1">
            <i class="fa-solid fa-layer-group text-pink-400"></i>
            <span>Diskografi & Albümler</span>
        </h2>

        @if (Model.Albums == null || !Model.Albums.Any())
        {
            <div class="rounded-2xl glass-card border border-white/10 p-8 text-center text-slate-400 text-sm">
                Bu sanatçıya ait henüz yayınlanmış bir albüm bulunmuyor.
            </div>
        }
        else
        {
            @for (int i = 0; i < Model.Albums.Count; i++)
            {
                var album = Model.Albums[i];
                bool isFirst = i == 0;
                var albumCover = string.IsNullOrEmpty(album.CoverImageUrl)
                    ? "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=400&q=80"
                    : album.CoverImageUrl;

                <div class="rounded-2xl glass-card border border-white/10 overflow-hidden transition-all">
                    <button type="button"
                            onclick="toggleAlbum(@album.Id)"
                            class="w-full p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-white/[0.04] transition-colors text-left cursor-pointer">
                        <div class="flex items-center gap-4 min-w-0">
                            <img src="@albumCover" alt="@album.Title"
                                 class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover border border-white/15 shrink-0" />

                            <div class="min-w-0">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="px-2.5 py-0.5 rounded-md bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 text-[11px] font-bold">
                                        @album.ReleaseYear
                                    </span>
                                    <span class="text-xs text-slate-400">
                                        @(album.Songs?.Count ?? 0) parça
                                    </span>
                                </div>
                                <h3 class="text-lg sm:text-xl font-extrabold text-white truncate">
                                    @album.Title
                                </h3>
                            </div>
                        </div>

                        <div class="w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center text-slate-300 shrink-0">
                            <i id="album-icon-@album.Id"
                               class="fa-solid fa-chevron-down transition-transform duration-300 @(isFirst ? "rotate-180" : "")"></i>
                        </div>
                    </button>

                    <div id="album-body-@album.Id" class="@(isFirst ? "" : "hidden") border-t border-white/10 bg-black/20">
                        @if (album.Songs == null || !album.Songs.Any())
                        {
                            <div class="p-5 text-xs text-slate-400 text-center">
                                Bu albümde henüz şarkı bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-white/[0.06]">
                                @for (int s = 0; s < album.Songs.Count; s++)
                                {
                                    var song = album.Songs[s];
                                    int reqLevel = (int)song.SubscriptionLevel;
                                    bool hasAccess = userLevel >= reqLevel;

                                    string playActionName = song.SubscriptionLevel switch
                                    {
                                        SubscriptionLevel.Diamond => "PlayDiamond",
                                        SubscriptionLevel.Premium => "PlayPremium",
                                        SubscriptionLevel.Standard => "PlayStandard",
                                        _ => "PlayFree"
                                    };

                                    var (lvlName, lvlClass, lvlIcon) = song.SubscriptionLevel switch
                                    {
                                        SubscriptionLevel.Diamond => ("Diamond", "bg-amber-500/20 text-amber-300 border-amber-400/40", "fa-gem"),
                                        SubscriptionLevel.Premium => ("Premium", "bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-400/40", "fa-crown"),
                                        SubscriptionLevel.Standard => ("Standard", "bg-cyan-500/20 text-cyan-300 border-cyan-400/40", "fa-bolt"),
                                        _ => ("Free", "bg-slate-800/90 text-slate-300 border-white/15", "fa-music")
                                    };

                                    <div class="px-4 sm:px-6 py-3.5 flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 hover:bg-white/[0.03] transition-colors">
                                        <div class="flex items-center gap-4 min-w-0">
                                            <span class="w-6 text-center text-xs font-mono text-slate-500">
                                                @(s + 1)
                                            </span>

                                            <div class="min-w-0">
                                                <p class="text-sm font-bold text-white truncate">@song.Title</p>
                                                <div class="flex items-center gap-3 text-[11px] text-slate-400 mt-0.5">
                                                    <span><i class="fa-regular fa-clock text-pink-400 mr-1"></i>@song.Duration.ToString(@"mm\:ss")</span>
                                                    <span><i class="fa-solid fa-headphones text-cyan-400 mr-1"></i>@song.PlayCount.ToString("N0")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-3 ml-auto">
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border text-[11px] font-bold @lvlClass">
                                                <i class="fa-solid @lvlIcon text-[10px]"></i> @lvlName
                                            </span>

                                            @if (hasAccess)
                                            {
                                                <a asp-controller="Music" asp-action="@playActionName" asp-route-id="@song.Id"
                                                   class="px-4 py-2 rounded-xl btn-gradient text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-md hover:scale-105 transition-transform">
                                                    <i class="fa-solid fa-play"></i>
                                                    <span>Dinle</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Auth" asp-action="SelectPlan" asp-route-targetLevel="@song.SubscriptionLevel"
                                                   class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-400/35 text-amber-300 font-bold text-xs inline-flex items-center gap-1.5 transition-all">
                                                    <i class="fa-solid fa-lock"></i>
                                                    <span>Kilidi Aç</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<script>
    function toggleAlbum(albumId) {
        const body = document.getElementById(`album-body-${albumId}`);
        const icon = document.getElementById(`album-icon-${albumId}`);

        if (!body || !icon) return;

        body.classList.toggle("hidden");
        icon.classList.toggle("rotate-180");
    }
</script>