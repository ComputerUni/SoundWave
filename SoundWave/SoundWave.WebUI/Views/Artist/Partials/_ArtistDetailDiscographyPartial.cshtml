@using SoundWave.Entity.Enums
@model SoundWave.DTO.ArtistDtos.ArtistDetailDto

@{
    int userLevel = ViewBag.UserLevel ?? 1;
}

<div class="z-10 relative space-y-5">
    <div class="flex items-center justify-between px-2">
        <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-xl bg-pink-500/20 border border-pink-500/30 flex items-center justify-center text-pink-400 text-sm">
                <i class="fa-solid fa-layer-group"></i>
            </span>
            <span>Diskografi & Albümler</span>
        </h2>
        <span class="text-xs text-slate-400 hidden sm:inline">
            Parçaları görmek için albüme tıklayın
        </span>
    </div>

    @if (Model.Albums == null || !Model.Albums.Any())
    {
        <div class="rounded-3xl bg-white/[0.03] border border-white/10 p-10 text-center text-slate-400 text-sm backdrop-blur-md">
            Bu sanatçıya ait henüz yayınlanmış bir albüm bulunmuyor.
        </div>
    }
    else
    {
        <div class="space-y-4">
            @for (int i = 0; i < Model.Albums.Count; i++)
            {
                var album = Model.Albums[i];
                bool isFirst = i == 0;
                var albumCover = string.IsNullOrEmpty(album.CoverImageUrl)
                    ? "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=400&q=80"
                    : album.CoverImageUrl;

                var albumDuration = TimeSpan.FromTicks(album.Songs?.Sum(s => s.Duration.Ticks) ?? 0);

                <div class="rounded-3xl bg-white/[0.04] border border-white/10 hover:border-white/20 overflow-hidden backdrop-blur-md transition-all duration-300 shadow-lg">

                    <div onclick="toggleAlbum(@album.Id)"
                         class="p-4 sm:p-6 flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 hover:bg-white/[0.04] transition-colors cursor-pointer select-none">

                        <div class="flex items-center gap-4 sm:gap-5 min-w-0">
                            <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border border-white/15 shadow-lg shrink-0">
                                <img src="@albumCover" alt="@album.Title" class="w-full h-full object-cover" />
                            </div>

                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                                    <span class="px-2.5 py-0.5 rounded-lg bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 text-[11px] font-bold">
                                        @album.ReleaseYear
                                    </span>
                                    <span class="text-xs text-slate-400">
                                        @(album.Songs?.Count ?? 0) parça • @((int)albumDuration.TotalMinutes) dk @albumDuration.Seconds sn
                                    </span>
                                </div>

                                <a asp-controller="Album" asp-action="Detail" asp-route-id="@album.Id"
                                   onclick="event.stopPropagation()"
                                   class="text-lg sm:text-2xl font-black text-white hover:text-pink-400 transition-colors truncate block">
                                    @album.Title
                                </a>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 ml-auto">
                            <a asp-controller="Album" asp-action="Detail" asp-route-id="@album.Id"
                               onclick="event.stopPropagation()"
                               class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/[0.05] hover:bg-pink-500/20 border border-white/10 hover:border-pink-500/40 text-xs font-semibold text-slate-300 hover:text-pink-300 transition-all">
                                <span>Albüme Git</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>

                            <div class="w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center text-slate-300 shrink-0">
                                <i id="album-icon-@album.Id"
                                   class="fa-solid fa-chevron-down transition-transform duration-300 @(isFirst ? "rotate-180" : "")"></i>
                            </div>
                        </div>
                    </div>

                    <div id="album-body-@album.Id" class="@(isFirst ? "" : "hidden") border-t border-white/10 bg-[#070912]/60">
                        @if (album.Songs == null || !album.Songs.Any())
                        {
                            <div class="p-6 text-xs text-slate-400 text-center">
                                Bu albümde henüz şarkı bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-white/[0.06]">
                                @for (int s = 0; s < album.Songs.Count; s++)
                                {
                                    var song = album.Songs[s];
                                    int reqLevel = (int)song.SubscriptionLevel;
                                    bool hasAccess = userLevel >= reqLevel;

                                    string playActionName = song.SubscriptionLevel switch
                                    {
                                        SubscriptionLevel.Diamond => "PlayDiamond",
                                        SubscriptionLevel.Premium => "PlayPremium",
                                        SubscriptionLevel.Standard => "PlayStandard",
                                        _ => "PlayFree"
                                    };

                                    var (lvlName, lvlClass, lvlIcon) = song.SubscriptionLevel switch
                                    {
                                        SubscriptionLevel.Diamond => ("Diamond", "bg-amber-500/20 text-amber-300 border-amber-400/40", "fa-gem"),
                                        SubscriptionLevel.Premium => ("Premium", "bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-400/40", "fa-crown"),
                                        SubscriptionLevel.Standard => ("Standard", "bg-cyan-500/20 text-cyan-300 border-cyan-400/40", "fa-bolt"),
                                        _ => ("Free", "bg-slate-800/90 text-slate-300 border-white/15", "fa-music")
                                    };

                                    <div class="group px-5 sm:px-7 py-4 flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 hover:bg-white/[0.04] transition-colors">
                                        <div class="flex items-center gap-4 min-w-0">
                                            <div class="w-9 h-9 rounded-xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-xs font-mono font-bold text-slate-400 group-hover:bg-pink-500/20 group-hover:border-pink-500/40 group-hover:text-pink-300 transition-all shrink-0">
                                                @((s + 1).ToString("D2"))
                                            </div>

                                            <div class="min-w-0">
                                                <p class="text-sm sm:text-base font-extrabold text-white truncate group-hover:text-pink-300 transition-colors">
                                                    @song.Title
                                                </p>
                                                <div class="flex items-center gap-3.5 text-xs text-slate-400 mt-1">
                                                    <span><i class="fa-regular fa-clock text-pink-400 mr-1"></i>@song.Duration.ToString(@"mm\:ss")</span>
                                                    <span><i class="fa-solid fa-headphones text-cyan-400 mr-1"></i>@song.PlayCount.ToString("N0")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-3 ml-auto">
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl border text-[11px] font-bold @lvlClass">
                                                <i class="fa-solid @lvlIcon text-[10px]"></i> @lvlName
                                            </span>

                                            @if (hasAccess)
                                            {
                                                <a asp-controller="Music" asp-action="@playActionName" asp-route-id="@song.Id"
                                                   class="px-5 py-2.5 rounded-xl btn-gradient text-white font-bold text-xs inline-flex items-center gap-2 shadow-lg hover:scale-105 active:scale-95 transition-all">
                                                    <i class="fa-solid fa-play"></i>
                                                    <span>Dinle</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Auth" asp-action="SelectPlan" asp-route-targetLevel="@song.SubscriptionLevel"
                                                   class="px-4 py-2.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-400/35 text-amber-300 font-bold text-xs inline-flex items-center gap-2 transition-all">
                                                    <i class="fa-solid fa-lock"></i>
                                                    <span>Kilidi Aç</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>