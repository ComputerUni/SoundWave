@using SoundWave.Entity.Enums
@model SoundWave.DTO.SelectPlanDtos.SelectPlanDto
@{
    Layout = null;
}

@await Component.InvokeAsync("_AuthLayoutSelectPlanHead")

@await Component.InvokeAsync("_AuthLayoutSelectPlanHeader")

@await Component.InvokeAsync("_AuthLayoutSelectPlanForm", Model)

@await Component.InvokeAsync("_AuthLayoutSelectPlanFooter")

<script>
    const radios = document.querySelectorAll('.plan-radio');
    const submitBtnText = document.getElementById('submitBtnText');

    const planLabels = {
        'Free': 'Free Paket ile Keşfetmeye Başla',
        'Standard': 'Standard Paket ile Keşfetmeye Başla',
        'Premium': 'Premium Paket ile Keşfetmeye Başla',
        'Diamond': 'Diamond (Hi-Fi) ile Keşfetmeye Başla'
    };

    radios.forEach(radio => {
        if(radio.checked) {
            submitBtnText?.innerText = planLabels[radio.value] || 'Seçili Paket ile Devam Et';
        }
        radio.addEventListener('change', (e) => {
            const selectedVal = e.target.value;
            submitBtnText.innerText = planLabels[selectedVal] || 'Seçili Paket ile Devam Et';
        });
    });
</script>
