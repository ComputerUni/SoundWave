@model SoundWave.DTO.AuthDtos.RegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol | SoundWave - Yeni Nesil Müzik Platformu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    animation: {
                        'pulse-slow': 'pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'equalizer-1': 'eq 1.2s ease-in-out infinite',
                        'equalizer-2': 'eq 0.9s ease-in-out infinite 0.2s',
                        'equalizer-3': 'eq 1.4s ease-in-out infinite 0.4s',
                        'equalizer-4': 'eq 1.0s ease-in-out infinite 0.1s',
                    },
                    keyframes: {
                        eq: {
                            '0%, 100%': { height: '8px' },
                            '50%': { height: '28px' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #07090E;
            overflow-x: hidden;
        }
        .glass-card {
            background: rgba(17, 22, 34, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .gradient-text {
            background: linear-gradient(135deg, #A855F7 0%, #EC4899 50%, #06B6D4 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .btn-gradient {
            background: linear-gradient(135deg, #7C3AED 0%, #DB2777 55%, #0891B2 100%);
            background-size: 200% auto;
            transition: all 0.4s ease;
        }
        .btn-gradient:hover {
            background-position: right center;
            box-shadow: 0 0 25px rgba(219, 39, 119, 0.45);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center text-slate-100 relative selection:bg-fuchsia-500 selection:text-white p-4 py-8">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-32 -right-32 w-96 h-96 bg-purple-600/25 rounded-full blur-[128px] animate-pulse-slow"></div>
        <div class="absolute top-1/2 -left-32 w-[28rem] h-[28rem] bg-cyan-500/20 rounded-full blur-[128px] animate-pulse-slow"></div>
        <div class="absolute -bottom-32 right-1/3 w-96 h-96 bg-pink-600/20 rounded-full blur-[128px] animate-pulse-slow"></div>
    </div>

    <div class="relative z-10 w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 rounded-3xl overflow-hidden shadow-[0_25px_70px_-15px_rgba(0,0,0,0.85)] glass-card">

        <div class="hidden lg:flex lg:col-span-5 flex-col justify-between p-10 bg-gradient-to-br from-cyan-950/50 via-slate-900/75 to-purple-950/60 border-r border-white/10 relative overflow-hidden">

            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-purple-600 via-pink-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-purple-500/30">
                        <i class="fa-solid fa-wave-square text-white text-xl"></i>
                    </div>
                    <span class="text-2xl font-extrabold tracking-tight text-white">Sound<span class="gradient-text">Wave</span></span>
                </div>

                <div class="flex items-end gap-1 h-8 px-3 py-1.5 rounded-full bg-white/5 border border-white/10">
                    <span class="w-1 bg-cyan-400 rounded-full animate-equalizer-1"></span>
                    <span class="w-1 bg-pink-400 rounded-full animate-equalizer-2"></span>
                    <span class="w-1 bg-purple-400 rounded-full animate-equalizer-3"></span>
                    <span class="w-1 bg-indigo-400 rounded-full animate-equalizer-4"></span>
                </div>
            </div>

            <div class="my-auto py-8">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-pink-300 mb-5">
                    <i class="fa-solid fa-sparkles text-cyan-400"></i> Saniyeler İçinde Katıl
                </span>
                <h1 class="text-3xl font-extrabold leading-tight text-white mb-4">
                    Ritmini Yakala, <br />
                    <span class="gradient-text">Ses Kaliteni Seç.</span>
                </h1>
                <p class="text-slate-400 text-sm leading-relaxed mb-7">
                    Ücretsiz hesabını hemen oluştur, binlerce parçayı keşfet. Dilediğin zaman paketini yükselterek reklamsız ve kayıpsız stüdyo sesine geçiş yap.
                </p>

                <div class="space-y-3.5 text-xs">
                    <div class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/10">
                        <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-headphones"></i>
                        </div>
                        <div>
                            <p class="font-bold text-slate-200">Anında Dinlemeye Başla</p>
                            <p class="text-slate-400 mt-0.5">Kayıt olduğun an Free paketiyle genel kataloğa erişim kazan.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/10">
                        <div class="w-8 h-8 rounded-lg bg-pink-500/20 text-pink-300 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <div>
                            <p class="font-bold text-slate-200">JWT Tabanlı Güvenli Oturum</p>
                            <p class="text-slate-400 mt-0.5">Paket yetkilerin token içerisinde şifreli ve güvenli şekilde taşınır.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/10">
                        <div class="w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-300 flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-crown"></i>
                        </div>
                        <div>
                            <p class="font-bold text-slate-200">Esnek Paket Yükseltme</p>
                            <p class="text-slate-400 mt-0.5">Standard, Premium ve Diamond (FLAC) paketlerine tek tıkla geç.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-white/10">
                <span>MyAcademy SoundWave</span>
                <span>v1.0 • JWT Auth</span>
            </div>
        </div>

        <div class="col-span-1 lg:col-span-7 p-8 sm:p-11 flex flex-col justify-center">

            <div class="flex lg:hidden items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-pink-500 to-cyan-400 flex items-center justify-center">
                    <i class="fa-solid fa-wave-square text-white text-lg"></i>
                </div>
                <span class="text-2xl font-extrabold text-white">Sound<span class="gradient-text">Wave</span></span>
            </div>

            <div class="mb-6">
                <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Yeni Hesap Oluştur</h2>
                <p class="text-slate-400 text-sm mt-1.5">Bilgilerini doldurarak SoundWave dünyasına adım at.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-start gap-2.5">
                    <i class="fa-solid fa-circle-exclamation text-rose-400 mt-0.5 text-sm"></i>
                    <div asp-validation-summary="All" class="space-y-1"></div>
                </div>
            }

            <form asp-controller="Auth" asp-action="Register" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FullName" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                            Ad Soyad
                        </label>
                        <div class="relative group">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-cyan-400 transition-colors">
                                <i class="fa-regular fa-id-card"></i>
                            </span>
                            <input asp-for="FullName" type="text" required
                                   placeholder="Mehmet Yılmaz"
                                   class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500/60 focus:ring-2 focus:ring-cyan-500/20 transition-all" />
                        </div>
                        <span asp-validation-for="FullName" class="text-[11px] text-rose-400 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="UserName" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                            Kullanıcı Adı
                        </label>
                        <div class="relative group">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-purple-400 transition-colors">
                                <i class="fa-solid fa-at"></i>
                            </span>
                            <input asp-for="UserName" type="text" required
                                   placeholder="mehmetyilmaz"
                                   class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-purple-500/60 focus:ring-2 focus:ring-purple-500/20 transition-all" />
                        </div>
                        <span asp-validation-for="UserName" class="text-[11px] text-rose-400 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                        E-Posta Adresi
                    </label>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-pink-400 transition-colors">
                            <i class="fa-regular fa-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" required
                               placeholder="ornek@soundwave.com"
                               class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500/60 focus:ring-2 focus:ring-pink-500/20 transition-all" />
                    </div>
                    <span asp-validation-for="Email" class="text-[11px] text-rose-400 mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                            Şifre
                        </label>
                        <div class="relative group">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-purple-400 transition-colors">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input asp-for="Password" id="passwordInput" type="password" required
                                   placeholder="••••••••"
                                   class="w-full pl-10 pr-10 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-purple-500/60 focus:ring-2 focus:ring-purple-500/20 transition-all" />
                            <button type="button" onclick="toggleField('passwordInput', 'eyeIcon1')" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-200 transition-colors">
                                <i id="eyeIcon1" class="fa-regular fa-eye text-xs"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-[11px] text-rose-400 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
                            Şifre Tekrar
                        </label>
                        <div class="relative group">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-pink-400 transition-colors">
                                <i class="fa-solid fa-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword" id="confirmPasswordInput" type="password" required
                                   placeholder="••••••••"
                                   class="w-full pl-10 pr-10 py-3 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500/60 focus:ring-2 focus:ring-pink-500/20 transition-all" />
                            <button type="button" onclick="toggleField('confirmPasswordInput', 'eyeIcon2')" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-200 transition-colors">
                                <i id="eyeIcon2" class="fa-regular fa-eye text-xs"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-[11px] text-rose-400 mt-1 block"></span>
                    </div>
                </div>

                <div class="p-3 rounded-xl bg-gradient-to-r from-purple-500/10 via-pink-500/10 to-cyan-500/10 border border-white/10 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="px-2.5 py-1 rounded-md bg-slate-800 border border-white/15 text-[11px] font-bold text-slate-200">
                            FREE PAKET
                        </span>
                        <span class="text-xs text-slate-300">Kayıt sonrası <strong>Ücretsiz (64 kbps)</strong> paketiyle başlarsınız.</span>
                    </div>
                    <i class="fa-solid fa-circle-info text-cyan-400 text-sm"></i>
                </div>

                <button type="submit" class="w-full py-3.5 px-6 rounded-xl font-bold text-sm text-white btn-gradient shadow-lg flex items-center justify-center gap-2 cursor-pointer mt-2">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                    <span>Hesabı Oluştur</span>
                </button>
            </form>

            <p class="text-center text-xs text-slate-400 mt-6">
                Zaten bir SoundWave hesabın var mı?
                <a asp-controller="Auth" asp-action="Login" class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-cyan-400 hover:underline ml-1">
                    Giriş Yap
                </a>
            </p>
        </div>
    </div>

    <script>
        function toggleField(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>