@using SoundWave.DTO.AuthDtos
@model LoginDto

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="relative z-10 w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 rounded-3xl overflow-hidden shadow-[0_25px_70px_-15px_rgba(0,0,0,0.85)] glass-card">

    @await Component.InvokeAsync("_AuthLayoutBrandPanel")

    @await Component.InvokeAsync("_AuthLayoutLoginForm", Model)

</div>

