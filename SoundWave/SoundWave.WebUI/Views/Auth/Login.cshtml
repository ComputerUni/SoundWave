@using SoundWave.DTO.AuthDtos
@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap | SoundWave - Yeni Nesil Müzik Platformu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    animation: {
                        'pulse-slow': 'pulse 6s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'equalizer-1': 'eq 1.2s ease-in-out infinite',
                        'equalizer-2': 'eq 0.9s ease-in-out infinite 0.2s',
                        'equalizer-3': 'eq 1.4s ease-in-out infinite 0.4s',
                        'equalizer-4': 'eq 1.0s ease-in-out infinite 0.1s',
                    },
                    keyframes: {
                        eq: {
                            '0%, 100%': { height: '8px' },
                            '50%': { height: '28px' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #07090E;
            overflow-x: hidden;
        }
        .glass-card {
            background: rgba(17, 22, 34, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .gradient-text {
            background: linear-gradient(135deg, #A855F7 0%, #EC4899 50%, #06B6D4 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .btn-gradient {
            background: linear-gradient(135deg, #7C3AED 0%, #DB2777 55%, #0891B2 100%);
            background-size: 200% auto;
            transition: all 0.4s ease;
        }
        .btn-gradient:hover {
            background-position: right center;
            box-shadow: 0 0 25px rgba(219, 39, 119, 0.45);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center text-slate-100 relative selection:bg-fuchsia-500 selection:text-white p-4">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-purple-600/25 rounded-full blur-[128px] animate-pulse-slow"></div>
        <div class="absolute top-1/2 -right-32 w-[28rem] h-[28rem] bg-cyan-500/20 rounded-full blur-[128px] animate-pulse-slow"></div>
        <div class="absolute -bottom-32 left-1/3 w-96 h-96 bg-pink-600/20 rounded-full blur-[128px] animate-pulse-slow"></div>
    </div>

    <div class="relative z-10 w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 rounded-3xl overflow-hidden shadow-[0_25px_70px_-15px_rgba(0,0,0,0.85)] glass-card">

        <div class="hidden lg:flex lg:col-span-6 flex-col justify-between p-10 bg-gradient-to-br from-purple-950/60 via-slate-900/70 to-cyan-950/60 border-r border-white/10 relative overflow-hidden">
            
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-purple-600 via-pink-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-purple-500/30">
                        <i class="fa-solid fa-wave-square text-white text-xl"></i>
                    </div>
                    <span class="text-2xl font-extrabold tracking-tight text-white">Sound<span class="gradient-text">Wave</span></span>
                </div>

                <div class="flex items-end gap-1 h-8 px-3 py-1.5 rounded-full bg-white/5 border border-white/10">
                    <span class="w-1 bg-purple-400 rounded-full animate-equalizer-1"></span>
                    <span class="w-1 bg-pink-400 rounded-full animate-equalizer-2"></span>
                    <span class="w-1 bg-cyan-400 rounded-full animate-equalizer-3"></span>
                    <span class="w-1 bg-indigo-400 rounded-full animate-equalizer-4"></span>
                </div>
            </div>

            <div class="my-auto py-8">

                <h1 class="text-4xl font-extrabold leading-tight text-white mb-4">
                    Müziğin Sınırlarını <br />
                    <span class="gradient-text">Paketinle Keşfet.</span>
                </h1>
                <p class="text-slate-400 text-sm leading-relaxed mb-8">
                    64 kbps standart yayından stüdyo kalitesinde kayıpsız FLAC deneyimine kadar, aboneliğine özel yetkilendirilmiş müzik dünyasına anında bağlan.
                </p>

                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div class="p-3 rounded-xl bg-white/[0.03] border border-white/10 flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                        <div>
                            <p class="font-bold text-slate-200">Free</p>
                            <p class="text-slate-500">64 kbps • Reklamlı</p>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-white/[0.03] border border-white/10 flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
                        <div>
                            <p class="font-bold text-cyan-300">Standard</p>
                            <p class="text-slate-500">128 kbps • Reklamsız</p>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-white/[0.03] border border-white/10 flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-fuchsia-400"></span>
                        <div>
                            <p class="font-bold text-fuchsia-300">Premium</p>
                            <p class="text-slate-500">320 kbps + Klipler</p>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-gradient-to-r from-purple-500/15 to-cyan-500/15 border border-purple-400/30 flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24]"></span>
                        <div>
                            <p class="font-bold text-amber-300">Diamond</p>
                            <p class="text-slate-400">FLAC + Stüdyo Özel</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-span-1 lg:col-span-6 p-8 sm:p-12 flex flex-col justify-center">
            
            <div class="flex lg:hidden items-center gap-3 mb-8">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-pink-500 to-cyan-400 flex items-center justify-center">
                    <i class="fa-solid fa-wave-square text-white text-lg"></i>
                </div>
                <span class="text-2xl font-extrabold text-white">Sound<span class="gradient-text">Wave</span></span>
            </div>

            <div class="mb-7">
                <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Tekrar Hoş Geldin</h2>
                <p class="text-slate-400 text-sm mt-1.5">Hesabına giriş yap ve abonelik paketindeki şarkıları dinlemeye başla.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-start gap-2.5">
                    <i class="fa-solid fa-circle-exclamation text-rose-400 mt-0.5 text-sm"></i>
                    <div asp-validation-summary="All" class="space-y-1"></div>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" class="space-y-5">
                <div>
                    <label asp-for="UserNameOrEmail" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">
                        Kullanıcı Adı veya E-Posta
                    </label>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 group-focus-within:text-pink-400 transition-colors">
                            <i class="fa-regular fa-envelope"></i>
                        </span>
                        <input asp-for="UserNameOrEmail" id="usernameInput" type="text" required
                               placeholder="ornek@soundwave.com"
                               class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500/60 focus:ring-2 focus:ring-pink-500/20 transition-all" />
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
                            Şifre
                        </label>
                        <a href="#" class="text-xs font-medium text-cyan-400 hover:text-cyan-300 transition-colors">Şifremi Unuttum?</a>
                    </div>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400 group-focus-within:text-purple-400 transition-colors">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input asp-for="Password" id="passwordInput" type="password" required
                               placeholder="••••••••"
                               class="w-full pl-11 pr-11 py-3.5 rounded-xl bg-slate-900/80 border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-purple-500/60 focus:ring-2 focus:ring-purple-500/20 transition-all" />
                        <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-200 transition-colors">
                            <i id="eyeIcon" class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="w-full py-3.5 px-6 rounded-xl font-bold text-sm text-white btn-gradient shadow-lg flex items-center justify-center gap-2 cursor-pointer">
                    <span>Giriş Yap</span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </form>

            <p class="text-center text-xs text-slate-400 mt-6">
                Henüz bir SoundWave hesabın yok mu?
                <a asp-controller="Auth" asp-action="Register" class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-cyan-400 hover:underline ml-1">
                    Paket Seç ve Kayıt Ol
                </a>
            </p>
        </div>
    </div>

    <script>
        function togglePassword() {
            const pwdInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                pwdInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }

        function fillDemo(email, password) {
            document.getElementById('usernameInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
</body>
</html>