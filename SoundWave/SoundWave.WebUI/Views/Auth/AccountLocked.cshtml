@{
    ViewData["Title"] = "Hesap Askıya Alındı";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoundWave</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-200 min-h-screen flex items-center justify-center p-4 selection:bg-rose-500 selection:text-white relative overflow-hidden">

    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-[300px] h-[300px] md:w-[500px] md:h-[500px] rounded-full bg-rose-500/10 blur-[120px] animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[250px] h-[250px] md:w-[450px] md:h-[450px] rounded-full bg-indigo-500/15 blur-[100px] animate-pulse delay-700"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#1e1b4b_1px,transparent_1px)] [background-size:24px_24px] opacity-20"></div>
    </div>

    <div class="w-full max-w-md bg-slate-950/40 border border-slate-800/80 backdrop-blur-xl rounded-3xl shadow-[0_0_50px_rgba(244,63,94,0.08)] p-8 md:p-10 text-center space-y-7 relative z-10 hover:border-rose-500/20 transition-all duration-500">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-40 h-[2px] bg-gradient-to-r from-transparent via-rose-500 to-transparent"></div>

        <div class="relative mx-auto w-20 h-20 flex items-center justify-center">
            <div class="absolute inset-0 rounded-2xl bg-rose-500/5 border border-rose-500/20 animate-ping opacity-70"></div>
            <div class="absolute inset-2 rounded-xl bg-gradient-to-tr from-rose-600/10 to-transparent border border-rose-500/30"></div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-rose-500 drop-shadow-[0_0_8px_rgba(244,63,94,0.5)] z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>

        <div class="space-y-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-rose-500/10 text-rose-400 border border-rose-500/20 shadow-[0_0_15px_rgba(244,63,94,0.1)]">
                ERİŞİM KISITLANDI
            </span>
            <h1 class="text-3xl font-extrabold text-white tracking-tight drop-shadow-sm">Hesabınız Askıya Alındı</h1>
            <p class="text-sm text-slate-400 leading-relaxed max-w-sm mx-auto">
                SoundWave hesabınıza erişim, platform kuralları veya yönetici kararı doğrultusunda geçici veya kalıcı olarak durdurulmuştur.
            </p>
        </div>

        <div class="bg-slate-900/30 border border-slate-800/60 rounded-2xl p-4 text-left text-xs text-slate-400 space-y-2.5">
            <p class="font-bold text-slate-300 flex items-center gap-1.5">
                <span class="w-1 h-3 rounded-full bg-rose-500"></span>
                Ne Yapabilirsiniz?
            </p>
            <ul class="space-y-2 pl-1">
                <li class="flex items-start gap-2">
                    <span class="text-rose-400 font-bold mt-0.5">•</span>
                    <span>Bunun bir hata olduğunu düşünüyorsanız, sistem yöneticisi veya destek ekibiyle iletişime geçin.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-rose-400 font-bold mt-0.5">•</span>
                    <span>Hesabınız tekrar aktifleştirildiğinde mevcut bilgilerinizle giriş yapabilirsiniz.</span>
                </li>
            </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <a asp-area="" asp-controller="Auth" asp-action="Login"
               class="w-full py-3 px-5 rounded-xl text-sm font-semibold bg-slate-900 border border-slate-800 text-slate-300 hover:bg-slate-800 hover:text-white hover:border-slate-700 transition duration-300 focus:outline-none">
                Giriş Sayfasına Dön
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="w-full py-3 px-5 rounded-xl text-sm font-semibold bg-gradient-to-r from-rose-600 to-indigo-600 hover:from-rose-500 hover:to-indigo-500 text-white shadow-lg shadow-rose-600/10 hover:shadow-rose-600/20 transition duration-300 focus:outline-none">
                Ana Sayfa
            </a>
        </div>
    </div>

</body>
</html>