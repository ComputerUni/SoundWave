@using SoundWave.Entity.Enums
@model SoundWave.DTO.ArtistDtos.AlbumWithSongsDto

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_MusicLayout.cshtml";

    int userLevel = ViewBag.UserLevel ?? 1;

    var coverUrl = string.IsNullOrEmpty(Model.CoverImageUrl)
        ? "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&q=85"
        : Model.CoverImageUrl;

    var firstSong = Model.Songs?.FirstOrDefault();
    string artistName = firstSong?.ArtistName ?? "Sanatçı";
    int artistId = firstSong?.ArtistId ?? 0;

    var totalDuration = TimeSpan.FromTicks(Model.Songs?.Sum(s => s.Duration.Ticks) ?? 0);
    long totalPlays = Model.Songs?.Sum(s => (long)s.PlayCount) ?? 0;

    var firstPlayableSong = Model.Songs?.FirstOrDefault(s => userLevel >= (int)s.SubscriptionLevel);
    string firstPlayAction = firstPlayableSong?.SubscriptionLevel switch
    {
        SubscriptionLevel.Diamond => "PlayDiamond",
        SubscriptionLevel.Premium => "PlayPremium",
        SubscriptionLevel.Standard => "PlayStandard",
        _ => "PlayFree"
    };
}

<style>
    @@keyframes floatSlow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-6px); }
    }

    .album-cover-float {
        animation: floatSlow 6s ease-in-out infinite;
    }
</style>

<div class="relative w-full min-h-[calc(100vh-135px)] rounded-[2rem] overflow-hidden border border-white/10 p-6 sm:p-10 lg:p-12 shadow-[0_25px_90px_-15px_rgba(0,0,0,0.85)]">

    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <img src="@coverUrl" alt=""
             class="w-full h-full object-cover scale-125 blur-[95px] opacity-35 saturate-150" />
        <div class="absolute inset-0 bg-gradient-to-br from-[#090b14]/90 via-[#0d1021]/85 to-[#080a12]/95"></div>
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-pink-600/20 blur-[110px]"></div>
        <div class="absolute top-1/3 -right-24 w-[28rem] h-[28rem] rounded-full bg-cyan-500/20 blur-[120px]"></div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 mb-10 z-10 relative">
        <a asp-controller="Music" asp-action="Discover"
           class="group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-white/[0.06] hover:bg-white/[0.12] border border-white/10 hover:border-pink-500/40 text-sm font-semibold text-slate-200 backdrop-blur-md transition-all duration-300">
            <i class="fa-solid fa-arrow-left text-pink-400 group-hover:-translate-x-1 transition-transform"></i>
            <span>Keşfet'e Dön</span>
        </a>

        @if (artistId > 0)
        {
            <a asp-controller="Artist" asp-action="Detail" asp-route-id="@artistId"
               class="group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-2xl bg-white/[0.05] hover:bg-pink-500/15 border border-white/10 hover:border-pink-500/40 text-xs sm:text-sm font-semibold text-slate-200 backdrop-blur-md transition-all">
                <i class="fa-solid fa-microphone-lines text-cyan-400"></i>
                <span>@artistName Profili</span>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
            </a>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center mb-12 z-10 relative">

        <div class="lg:col-span-5 flex items-center justify-center">
            <div class="relative group flex items-center justify-center py-4 pr-8 sm:pr-12">

                <div class="absolute -inset-4 rounded-full bg-gradient-to-tr from-pink-500/30 via-fuchsia-500/20 to-cyan-400/30 blur-2xl opacity-60 group-hover:opacity-90 transition-opacity duration-700"></div>

                <div class="album-cover-float absolute right-0 sm:right-2 w-52 h-52 sm:w-64 sm:h-64 rounded-full bg-gradient-to-br from-slate-900 via-zinc-950 to-black border border-white/15 shadow-2xl flex items-center justify-center transition-transform duration-700 group-hover:translate-x-4 group-hover:rotate-45">
                    <div class="w-44 h-44 sm:w-52 sm:h-52 rounded-full border border-white/[0.06] flex items-center justify-center">
                        <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full border border-white/[0.06] flex items-center justify-center">
                            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-pink-500/50 relative">
                                <img src="@coverUrl" alt="" class="w-full h-full object-cover opacity-80" />
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="w-3.5 h-3.5 rounded-full bg-[#090b14] border border-white/30"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="relative w-56 h-56 sm:w-72 sm:h-72 rounded-3xl overflow-hidden border-2 border-white/20 shadow-[0_25px_60px_rgba(0,0,0,0.85)] z-10">
                    <img src="@coverUrl" alt="@Model.Title" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-tr from-black/30 via-transparent to-white/15"></div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 mb-4">
                <span class="px-3.5 py-1.5 rounded-xl bg-pink-500/15 border border-pink-500/35 text-pink-300 text-xs font-extrabold tracking-wider uppercase backdrop-blur-md">
                    <i class="fa-solid fa-compact-disc mr-1.5"></i>Stüdyo Albümü
                </span>
                <span class="px-3.5 py-1.5 rounded-xl bg-white/[0.07] border border-white/10 text-cyan-300 text-xs font-bold backdrop-blur-md">
                    <i class="fa-regular fa-calendar mr-1.5"></i>@Model.ReleaseYear
                </span>
            </div>

            <h1 class="text-3xl sm:text-5xl xl:text-6xl font-black text-white tracking-tight leading-tight mb-3">
                @Model.Title
            </h1>

            <div class="mb-7">
                @if (artistId > 0)
                {
                    <a asp-controller="Artist" asp-action="Detail" asp-route-id="@artistId"
                       class="text-lg sm:text-2xl font-bold text-slate-200 hover:text-pink-400 transition-colors">
                        @artistName
                    </a>
                }
                else
                {
                    <span class="text-lg sm:text-2xl font-bold text-slate-300">@artistName</span>
                }
            </div>

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 text-xs sm:text-sm text-slate-300 mb-8">
                <div class="px-4 py-2.5 rounded-2xl bg-white/[0.06] border border-white/10 backdrop-blur-md flex items-center gap-2">
                    <i class="fa-solid fa-music text-pink-400"></i>
                    <span><strong class="text-white">@(Model.Songs?.Count ?? 0)</strong> Parça</span>
                </div>
                <div class="px-4 py-2.5 rounded-2xl bg-white/[0.06] border border-white/10 backdrop-blur-md flex items-center gap-2">
                    <i class="fa-regular fa-clock text-cyan-400"></i>
                    <span><strong class="text-white">@((int)totalDuration.TotalMinutes) dk @totalDuration.Seconds sn</strong></span>
                </div>
                <div class="px-4 py-2.5 rounded-2xl bg-white/[0.06] border border-white/10 backdrop-blur-md flex items-center gap-2">
                    <i class="fa-solid fa-headphones text-fuchsia-400"></i>
                    <span><strong class="text-white">@totalPlays.ToString("N0")</strong> Dinlenme</span>
                </div>
            </div>

            @if (firstPlayableSong != null)
            {
                <a asp-controller="Music" asp-action="@firstPlayAction" asp-route-id="@firstPlayableSong.Id"
                   class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl btn-gradient text-white font-extrabold text-sm sm:text-base shadow-[0_0_40px_rgba(236,72,153,0.45)] hover:scale-105 active:scale-95 transition-all">
                    <i class="fa-solid fa-play text-base"></i>
                    <span>Albümü Çalmaya Başla</span>
                </a>
            }
            else if (Model.Songs != null && Model.Songs.Any())
            {
                <a asp-controller="Auth" asp-action="SelectPlan"
                   class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/40 text-amber-300 font-extrabold text-sm sm:text-base transition-all">
                    <i class="fa-solid fa-crown"></i>
                    <span>Albüm Erişimi İçin Paketi Yükselt</span>
                </a>
            }
        </div>
    </div>

    <div class="z-10 relative">
        <div class="flex items-center justify-between px-2 mb-4">
            <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-pink-500/20 border border-pink-500/30 flex items-center justify-center text-pink-400 text-sm">
                    <i class="fa-solid fa-sliders"></i>
                </span>
                <span>Parça Listesi</span>
            </h2>
            <span class="text-xs text-slate-400 hidden sm:inline">
                Dinlemek istediğiniz parçayı seçin
            </span>
        </div>

        @if (Model.Songs == null || !Model.Songs.Any())
        {
            <div class="rounded-3xl bg-white/[0.03] border border-white/10 p-10 text-center text-slate-400 text-sm backdrop-blur-md">
                Bu albümde henüz yayınlanmış parça bulunmuyor.
            </div>
        }
        else
        {
            <div class="space-y-2.5">
                @for (int i = 0; i < Model.Songs.Count; i++)
                {
                    var song = Model.Songs[i];
                    int reqLevel = (int)song.SubscriptionLevel;
                    bool hasAccess = userLevel >= reqLevel;

                    string playActionName = song.SubscriptionLevel switch
                    {
                        SubscriptionLevel.Diamond => "PlayDiamond",
                        SubscriptionLevel.Premium => "PlayPremium",
                        SubscriptionLevel.Standard => "PlayStandard",
                        _ => "PlayFree"
                    };

                    var (lvlName, lvlClass, lvlIcon) = song.SubscriptionLevel switch
                    {
                        SubscriptionLevel.Diamond => ("Diamond", "bg-amber-500/20 text-amber-300 border-amber-400/40", "fa-gem"),
                        SubscriptionLevel.Premium => ("Premium", "bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-400/40", "fa-crown"),
                        SubscriptionLevel.Standard => ("Standard", "bg-cyan-500/20 text-cyan-300 border-cyan-400/40", "fa-bolt"),
                        _ => ("Free", "bg-slate-800/90 text-slate-300 border-white/15", "fa-music")
                    };

                    <div class="group rounded-2xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] @(hasAccess ? "hover:border-pink-500/40 hover:shadow-[0_10px_30px_-10px_rgba(236,72,153,0.25)]" : "opacity-80 hover:opacity-100") px-4 sm:px-6 py-4 flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 backdrop-blur-md transition-all duration-300">

                        <div class="flex items-center gap-4 min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center font-mono text-xs font-bold text-slate-400 group-hover:bg-pink-500/20 group-hover:border-pink-500/40 group-hover:text-pink-300 transition-all shrink-0">
                                @((i + 1).ToString("D2"))
                            </div>

                            <div class="min-w-0">
                                <h3 class="text-sm sm:text-base font-extrabold text-white truncate group-hover:text-pink-300 transition-colors">
                                    @song.Title
                                </h3>
                                <div class="flex items-center gap-3.5 text-xs text-slate-400 mt-1">
                                    <span>
                                        <i class="fa-regular fa-clock text-pink-400 mr-1"></i>@song.Duration.ToString(@"mm\:ss")
                                    </span>
                                    <span>
                                        <i class="fa-solid fa-headphones text-cyan-400 mr-1"></i>@song.PlayCount.ToString("N0")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 ml-auto">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl border text-[11px] font-bold @lvlClass">
                                <i class="fa-solid @lvlIcon text-[10px]"></i> @lvlName
                            </span>

                            @if (hasAccess)
                            {
                                <a asp-controller="Music" asp-action="@playActionName" asp-route-id="@song.Id"
                                   class="px-5 py-2.5 rounded-xl btn-gradient text-white font-bold text-xs inline-flex items-center gap-2 shadow-lg hover:scale-105 active:scale-95 transition-all">
                                    <i class="fa-solid fa-play"></i>
                                    <span>Dinle</span>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Auth" asp-action="SelectPlan" asp-route-targetLevel="@song.SubscriptionLevel"
                                   class="px-4 py-2.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-400/35 text-amber-300 font-bold text-xs inline-flex items-center gap-2 transition-all">
                                    <i class="fa-solid fa-lock"></i>
                                    <span>Kilidi Aç</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>