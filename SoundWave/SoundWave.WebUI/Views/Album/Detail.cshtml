@model SoundWave.DTO.ArtistDtos.AlbumWithSongsDto

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_MusicLayout.cshtml";

    var coverUrl = string.IsNullOrEmpty(Model.CoverImageUrl)
        ? "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&q=85"
        : Model.CoverImageUrl;
}

<style>
    @@keyframes floatSlow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-6px); }
    }

    .album-cover-float {
        animation: floatSlow 6s ease-in-out infinite;
    }
</style>

<div class="relative w-full min-h-[calc(100vh-135px)] rounded-[2rem] overflow-hidden border border-white/10 p-6 sm:p-10 lg:p-12 shadow-[0_25px_90px_-15px_rgba(0,0,0,0.85)]">

    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <img src="@coverUrl" alt=""
             class="w-full h-full object-cover scale-125 blur-[95px] opacity-35 saturate-150" />
        <div class="absolute inset-0 bg-gradient-to-br from-[#090b14]/90 via-[#0d1021]/85 to-[#080a12]/95"></div>
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-pink-600/20 blur-[110px]"></div>
        <div class="absolute top-1/3 -right-24 w-[28rem] h-[28rem] rounded-full bg-cyan-500/20 blur-[120px]"></div>
    </div>

    <partial name="Partials/_AlbumTopBarPartial" model="Model" />
    <partial name="Partials/_AlbumHeroPartial" model="Model" />
    <partial name="Partials/_AlbumTracklistPartial" model="Model" />
</div>