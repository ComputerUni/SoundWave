@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<div id="sidebar-backdrop" onclick="toggleAdminSidebar()"
     class="fixed inset-0 bg-black/70 backdrop-blur-sm z-30 hidden lg:hidden"></div>

<aside id="admin-sidebar"
       class="fixed lg:sticky top-0 left-0 z-40 h-screen w-72 shrink-0 bg-[#0b0e1c]/95 border-r border-white/10 backdrop-blur-xl flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0">

    <div class="h-20 px-6 flex items-center justify-between border-b border-white/10">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-2xl btn-gradient flex items-center justify-center text-white shadow-[0_0_25px_rgba(236,72,153,0.45)] group-hover:scale-105 transition-transform">
                <i class="fa-solid fa-wave-square text-base"></i>
            </div>
            <div>
                <span class="text-lg font-black tracking-tight text-white block leading-none">
                    Sound<span class="text-pink-400">Wave</span>
                </span>
                <span class="text-[10px] font-bold uppercase tracking-widest text-cyan-400 mt-1 block">
                    Studio Admin
                </span>
            </div>
        </a>

        <button type="button" onclick="toggleAdminSidebar()" class="lg:hidden text-slate-400 hover:text-white p-2">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
        <p class="px-3 text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-3">
            Genel Bakış
        </p>

        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="flex items-center gap-3.5 px-4 py-3 rounded-2xl border border-transparent text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all @(currentController == "Dashboard" ? "sidebar-active" : "")">
            <i class="fa-solid fa-chart-pie w-5 text-center @(currentController == "Dashboard" ? "text-pink-400" : "text-slate-400")"></i>
            <span>Dashboard</span>
        </a>

        <p class="px-3 pt-5 text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-3">
            İçerik Yönetimi
        </p>

        <a asp-area="Admin" asp-controller="Artist" asp-action="Index"
           class="flex items-center gap-3.5 px-4 py-3 rounded-2xl border border-transparent text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all @(currentController == "Artist" ? "sidebar-active" : "")">
            <i class="fa-solid fa-microphone-lines w-5 text-center @(currentController == "Artist" ? "text-pink-400" : "text-slate-400")"></i>
            <span>Sanatçılar</span>
        </a>

        <a asp-area="Admin" asp-controller="Album" asp-action="Index"
           class="flex items-center gap-3.5 px-4 py-3 rounded-2xl border border-transparent text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all @(currentController == "Album" ? "sidebar-active" : "")">
            <i class="fa-solid fa-compact-disc w-5 text-center @(currentController == "Album" ? "text-cyan-400" : "text-slate-400")"></i>
            <span>Albümler</span>
        </a>

        <a asp-area="Admin" asp-controller="Song" asp-action="Index"
           class="flex items-center gap-3.5 px-4 py-3 rounded-2xl border border-transparent text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all @(currentController == "Song" ? "sidebar-active" : "")">
            <i class="fa-solid fa-music w-5 text-center @(currentController == "Song" ? "text-fuchsia-400" : "text-slate-400")"></i>
            <span>Şarkılar</span>
        </a>

        <p class="px-3 pt-5 text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-3">
            Abonelik & Sistem
        </p>

        <a asp-area="Admin" asp-controller="User" asp-action="Index"
           class="flex items-center gap-3.5 px-4 py-3 rounded-2xl border border-transparent text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all @(currentController == "User" ? "sidebar-active" : "")">
            <i class="fa-solid fa-users-gear w-5 text-center @(currentController == "User" ? "text-amber-400" : "text-slate-400")"></i>
            <span>Kullanıcılar & Paketler</span>
        </a>
    </nav>

    <div class="p-4 border-t border-white/10 space-y-2">
        <a asp-area="" asp-controller="Music" asp-action="Discover"
           class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-bold text-slate-200 transition-all">
            <i class="fa-solid fa-arrow-up-right-from-square text-cyan-400"></i>
            <span>Uygulamaya Geç</span>
        </a>

        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit"
                    class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-xs font-bold text-rose-300 transition-all">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Çıkış Yap</span>
            </button>
        </form>
    </div>
</aside>