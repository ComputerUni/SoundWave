@model SoundWave.DTO.DashboardDtos.ResultDashboardDto
@using System.Text.Json
@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; 
}

<div class="p-6 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Genel Bakış</h1>
            <p class="text-sm text-slate-400 mt-1">SoundWave platform istatistiklerini, abonelik dağılımını ve son hareketleri takip edin.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <a asp-area="Admin" asp-controller="Song" asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-500 shadow-lg shadow-indigo-600/20 transition">
                <span>+ Yeni Şarkı</span>
            </a>
            <a asp-area="Admin" asp-controller="Album" asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 hover:text-white transition">
                <span>+ Yeni Albüm</span>
            </a>
            <a asp-area="Admin" asp-controller="User" asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 hover:text-white transition">
                <span>Kullanıcı Yönetimi</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg hover:border-indigo-500/30 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Toplam Kullanıcı</p>
                    <h3 class="text-3xl font-extrabold text-white mt-2">@Model.TotalUsers</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-400">Askıdaki Hesaplar</span>
                <span class="font-semibold @(Model.LockedUsersCount > 0 ? "text-rose-400" : "text-emerald-400")">
                    @Model.LockedUsersCount kilitli
                </span>
            </div>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg hover:border-purple-500/30 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Toplam Sanatçı</p>
                    <h3 class="text-3xl font-extrabold text-white mt-2">@Model.TotalArtists</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-400">Katalog Sanatçıları</span>
                <a asp-area="Admin" asp-controller="Artist" asp-action="Index" class="text-purple-400 hover:underline font-medium">Tümünü Gör →</a>
            </div>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg hover:border-cyan-500/30 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Toplam Albüm</p>
                    <h3 class="text-3xl font-extrabold text-white mt-2">@Model.TotalAlbums</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 5.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-400">Yayınlanan Albümler</span>
                <a asp-area="Admin" asp-controller="Album" asp-action="Index" class="text-cyan-400 hover:underline font-medium">Tümünü Gör →</a>
            </div>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg hover:border-emerald-500/30 transition">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Toplam Şarkı</p>
                    <h3 class="text-3xl font-extrabold text-white mt-2">@Model.TotalSong</h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                    </svg>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-400">Müzik Kütüphanesi</span>
                <a asp-area="Admin" asp-controller="Song" asp-action="Index" class="text-emerald-400 hover:underline font-medium">Tümünü Gör →</a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-5 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
            <div>
                <h2 class="text-base font-bold text-white">Abonelik Paketi Dağılımı</h2>
                <p class="text-xs text-slate-400 mt-0.5">Kullanıcıların mevcut üyelik seviyelerine göre oranı</p>
            </div>
            <div class="relative h-64 my-4 flex items-center justify-center">
                <canvas id="packageChart"></canvas>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-800/80 text-xs">
                <div class="flex items-center justify-between px-2 py-1 rounded bg-slate-950/50">
                    <span class="text-slate-400">Free</span>
                    <span class="font-bold text-slate-200">@Model.FreeUserCount</span>
                </div>
                <div class="flex items-center justify-between px-2 py-1 rounded bg-slate-950/50">
                    <span class="text-indigo-400">Standard</span>
                    <span class="font-bold text-white">@Model.StandardUserCount</span>
                </div>
                <div class="flex items-center justify-between px-2 py-1 rounded bg-slate-950/50">
                    <span class="text-amber-400">Premium</span>
                    <span class="font-bold text-white">@Model.PremiumUserCount</span>
                </div>
                <div class="flex items-center justify-between px-2 py-1 rounded bg-slate-950/50">
                    <span class="text-cyan-400">Diamond</span>
                    <span class="font-bold text-white">@Model.DiamondUserCount</span>
                </div>
            </div>
        </div>

        <div class="lg:col-span-7 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
            <div>
                <h2 class="text-base font-bold text-white">En Çok Şarkıya Sahip Sanatçılar</h2>
                <p class="text-xs text-slate-400 mt-0.5">Platformdaki parça sayısına göre ilk 5 sanatçı</p>
            </div>
            <div class="relative h-72 mt-4">
                <canvas id="topArtistsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-7 bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
            <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-white">Son Eklenen Şarkılar</h2>
                    <p class="text-xs text-slate-400">Kataloğa eklenen son 5 parça</p>
                </div>
                <a asp-area="Admin" asp-controller="Song" asp-action="Index" class="text-xs font-medium text-indigo-400 hover:text-indigo-300">Tümü →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-800 bg-slate-950/40 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                            <th class="px-6 py-3">Şarkı</th>
                            <th class="px-6 py-3">Sanatçı / Albüm</th>
                            <th class="px-6 py-3">Seviye</th>
                            <th class="px-6 py-3 text-right">Dinlenme</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/70 text-sm text-slate-300">
                        @if (Model.RecentSongs.Any())
                        {
                            @foreach (var song in Model.RecentSongs)
                            {
                                var levelBadge = song.SubscriptionLevel switch
                                {
                                    SoundWave.Entity.Enums.SubscriptionLevel.Diamond => "bg-cyan-500/15 text-cyan-400 border-cyan-500/30",
                                    SoundWave.Entity.Enums.SubscriptionLevel.Premium => "bg-amber-500/15 text-amber-400 border-amber-500/30",
                                    SoundWave.Entity.Enums.SubscriptionLevel.Standard => "bg-indigo-500/15 text-indigo-400 border-indigo-500/30",
                                    _ => "bg-slate-700/40 text-slate-300 border-slate-600/40"
                                };

                                <tr class="hover:bg-slate-800/40 transition-colors">
                                    <td class="px-6 py-3.5 font-medium text-white">@song.Title</td>
                                    <td class="px-6 py-3.5">
                                        <div class="text-slate-200 text-xs font-medium">@song.ArtistName</div>
                                        <div class="text-slate-500 text-[11px]">@song.AlbumTitle</div>
                                    </td>
                                    <td class="px-6 py-3.5">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold border @levelBadge">
                                            @song.SubscriptionLevel
                                        </span>
                                    </td>
                                    <td class="px-6 py-3.5 text-right font-mono text-xs text-slate-400">
                                        @song.PlayCount.ToString("N0")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-xs text-slate-500">Henüz şarkı kaydı bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="lg:col-span-5 bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
            <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-white">Son Kayıt Olan Üyeler</h2>
                    <p class="text-xs text-slate-400">Sisteme katılan son 5 kullanıcı</p>
                </div>
                <a asp-area="Admin" asp-controller="User" asp-action="Index" class="text-xs font-medium text-indigo-400 hover:text-indigo-300">Tümü →</a>
            </div>
            <div class="divide-y divide-slate-800/70">
                @if (Model.RecentUsers.Any())
                {
                    @foreach (var user in Model.RecentUsers)
                    {
                        <div class="px-6 py-3.5 flex items-center justify-between hover:bg-slate-800/40 transition-colors">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-white truncate">@user.FullName</p>
                                <p class="text-xs text-slate-400 truncate">@@@user.UserName • @user.Email</p>
                            </div>
                            <div class="ml-3 shrink-0">
                                @if (user.IsLockedOut)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-rose-500/15 text-rose-400 border border-rose-500/30">
                                        Askıda
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                                        Aktif
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="px-6 py-8 text-center text-xs text-slate-500">Henüz kullanıcı kaydı bulunmuyor.</div>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const packageCtx = document.getElementById('packageChart').getContext('2d');
        new Chart(packageCtx, {
            type: 'doughnut',
            data: {
                labels: ['Free', 'Standard', 'Premium', 'Diamond'],
                datasets: [{
                    data: [
                        @Model.FreeUserCount,
                        @Model.StandardUserCount,
                        @Model.PremiumUserCount,
                        @Model.DiamondUserCount
                    ],
                    backgroundColor: [
                        'rgba(100, 116, 139, 0.8)', 
                        'rgba(99, 102, 241, 0.85)', 
                        'rgba(245, 158, 11, 0.85)', 
                        'rgba(6, 182, 212, 0.85)'   
                    ],
                    borderColor: '#0f172a',
                    borderWidth: 3,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#cbd5e1',
                            padding: 16,
                            font: { size: 12 }
                        }
                    }
                }
            }
        });

        const artistLabels = @Html.Raw(JsonSerializer.Serialize(Model.TopArtistNames));
        const artistData = @Html.Raw(JsonSerializer.Serialize(Model.TopArtistSongCounts));

        const artistsCtx = document.getElementById('topArtistsChart').getContext('2d');
        new Chart(artistsCtx, {
            type: 'bar',
            data: {
                labels: artistLabels,
                datasets: [{
                    label: 'Şarkı Sayısı',
                    data: artistData,
                    backgroundColor: 'rgba(99, 102, 241, 0.75)',
                    borderColor: 'rgba(129, 140, 248, 1)',
                    borderWidth: 1,
                    borderRadius: 8,
                    maxBarThickness: 44
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 12 } }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(30, 41, 59, 0.7)' },
                        ticks: {
                            color: '#94a3b8',
                            stepSize: 1,
                            precision: 0
                        }
                    }
                }
            }
        });
    });
</script>