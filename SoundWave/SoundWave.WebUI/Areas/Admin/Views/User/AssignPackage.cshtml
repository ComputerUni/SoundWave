@model SoundWave.DTO.UserDtos.AssignPackageDto
@using SoundWave.Entity.Enums
@{
    ViewData["Title"] = "Paket Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; 
}

<div class="p-6 flex justify-center">
    <div class="w-full max-w-lg bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-800 bg-slate-950/40">
            <h2 class="text-lg font-bold text-white">Abonelik Paketi Güncelle</h2>
            <p class="text-xs text-slate-400 mt-0.5">Kullanıcının mevcut abonelik seviyesini değiştirin.</p>
        </div>

        <div class="p-6 space-y-6">
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 space-y-3 text-sm">
                <div class="flex items-center justify-between">
                    <span class="text-slate-400">Kullanıcı</span>
                    <span class="font-semibold text-white">@Model.FullName</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-400">E-posta</span>
                    <span class="text-slate-300">@Model.Email</span>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
                    <span class="text-slate-400">Mevcut Paket</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-indigo-500/15 text-indigo-400 border border-indigo-500/30">
                        @Model.CurrentPackage
                    </span>
                </div>
            </div>


            <form asp-area="Admin" asp-controller="User" asp-action="AssignPackage" method="post" class="space-y-5">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="CurrentPackage" />

                <div>
                    <label asp-for="SelectedPackage" class="block text-sm font-medium text-slate-200 mb-2">
                        Yeni Abonelik Paketi
                    </label>
                    <select asp-for="SelectedPackage"
                            asp-items="Html.GetEnumSelectList<SubscriptionLevel>()"
                            class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                    </select>
                    <p class="text-xs text-slate-400 mt-2">
                        Kaydettiğinizde kullanıcının önceki paket rolü kaldırılacak ve seçilen yeni paket atanacaktır.
                    </p>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index"
                       class="px-4 py-2 rounded-xl text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                        Vazgeç
                    </a>
                    <button type="submit"
                            class="px-5 py-2 rounded-xl text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-500 shadow-lg shadow-indigo-600/20 transition-colors">
                        Paketi Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>