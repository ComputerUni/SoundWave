@model List<SoundWave.DTO.UserDtos.ResultUserDto>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-6 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Kullanıcı Yönetimi</h1>
            <p class="text-sm text-slate-400 mt-1">Sistemdeki kayıtlı kullanıcıları, abonelik paketlerini ve hesap durumlarını yönetin.</p>
        </div>
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-medium bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
            Toplam: @Model.Count Kullanıcı
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center justify-between p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm">
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-300 font-bold ml-4">✕</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center justify-between p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm">
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-300 font-bold ml-4">✕</button>
        </div>
    }

    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-800 bg-slate-950/50 text-xs font-semibold uppercase tracking-wider text-slate-400">
                        <th class="px-6 py-4">Ad Soyad</th>
                        <th class="px-6 py-4">Kullanıcı Adı</th>
                        <th class="px-6 py-4">E-posta</th>
                        <th class="px-6 py-4">Kayıt Tarihi</th>
                        <th class="px-6 py-4">Paket / Rol</th>
                        <th class="px-6 py-4">Durum</th>
                        <th class="px-6 py-4 text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/70 text-sm text-slate-300">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-800/40 transition-colors">
                            <td class="px-6 py-4 font-medium text-white">@item.FullName</td>
                            <td class="px-6 py-4 text-slate-400">@item.UserName</td>
                            <td class="px-6 py-4 text-slate-400">@item.Email</td>
                            <td class="px-6 py-4 text-slate-400">@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td class="px-6 py-4">
                                @if (item.IsAdmin)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-purple-500/15 text-purple-400 border border-purple-500/30">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    var badgeClasses = item.SubscriptionLevel switch
                                    {
                                        SoundWave.Entity.Enums.SubscriptionLevel.Diamond => "bg-cyan-500/15 text-cyan-400 border-cyan-500/30",
                                        SoundWave.Entity.Enums.SubscriptionLevel.Premium => "bg-amber-500/15 text-amber-400 border-amber-500/30",
                                        SoundWave.Entity.Enums.SubscriptionLevel.Standard => "bg-indigo-500/15 text-indigo-400 border-indigo-500/30",
                                        _ => "bg-slate-700/40 text-slate-300 border-slate-600/40"
                                    };
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold border @badgeClasses">
                                        @item.SubscriptionLevel
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.IsLockedOut)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-500/15 text-rose-400 border border-rose-500/30">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                                        Askıda
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                        Aktif
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (!item.IsAdmin)
                                {
                                    <div class="inline-flex items-center justify-end gap-2">
                                        <a asp-area="Admin" asp-controller="User" asp-action="AssignPackage" asp-route-id="@item.Id"
                                           class="px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-500/15 text-indigo-400 border border-indigo-500/30 hover:bg-indigo-500 hover:text-white transition-colors">
                                            Paket Değiştir
                                        </a>

                                        <form asp-area="Admin" asp-controller="User" asp-action="ToggleLockout" asp-route-id="@item.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors @(item.IsLockedOut
                                                        ? "bg-emerald-500/15 text-emerald-400 border-emerald-500/30 hover:bg-emerald-500 hover:text-white"
                                                        : "bg-amber-500/15 text-amber-400 border-amber-500/30 hover:bg-amber-500 hover:text-slate-950")">
                                                @(item.IsLockedOut ? "Kilidi Aç" : "Askıya Al")
                                            </button>
                                        </form>

                                        <form asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline"
                                              onsubmit="return confirm('@item.FullName adlı kullanıcıyı kalıcı olarak silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-lg text-xs font-medium bg-rose-500/15 text-rose-400 border border-rose-500/30 hover:bg-rose-500 hover:text-white transition-colors">
                                                Sil
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-500 italic">Yönetici Hesabı</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>