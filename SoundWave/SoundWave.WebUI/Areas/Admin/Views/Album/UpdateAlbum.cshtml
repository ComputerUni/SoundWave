@using SoundWave.DTO.AlbumDtos
@model UpdateAlbumDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Albüm Güncelle";
}

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 rounded-3xl bg-[#0b0e1c]/90 border border-white/10 backdrop-blur-xl">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-pink-500/15 border border-pink-500/30 flex items-center justify-center text-pink-400">
                <i class="fa-solid fa-pen-to-square text-xl"></i>
            </div>
            <div>
                <h2 class="text-lg font-extrabold text-white tracking-tight">Albüm Bilgilerini Düzenle</h2>
                <p class="text-xs text-slate-400 mt-0.5">
                    <span class="text-pink-400 font-bold">#@Model.Id</span> numaralı albüm kaydını güncelliyorsunuz.
                </p>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Album" asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-bold text-slate-200 transition-all">
            <i class="fa-solid fa-arrow-left text-pink-400"></i>
            <span>Listeye Dön</span>
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 p-6 sm:p-8 rounded-3xl bg-[#0b0e1c]/90 border border-white/10 backdrop-blur-xl shadow-2xl">
            <form asp-area="Admin" asp-controller="Album" asp-action="UpdateAlbum" method="post" novalidate class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-xs text-rose-300 font-semibold"></div>

                <div class="space-y-2">
                    <label asp-for="Title" class="block text-xs font-extrabold uppercase tracking-wider text-slate-300">
                        Albüm Adı <span class="text-pink-400">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-500">
                            <i class="fa-solid fa-record-vinyl"></i>
                        </span>
                        <input asp-for="Title" id="albumTitleInput" placeholder="Örn: Random Access Memories"
                               class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-white/[0.04] border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500/60 focus:ring-2 focus:ring-cyan-500/20 transition-all" />
                    </div>
                    <span asp-validation-for="Title" class="text-xs text-rose-400 font-semibold block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="space-y-2">
                        <label asp-for="ArtistId" class="block text-xs font-extrabold uppercase tracking-wider text-slate-300">
                            Sanatçı <span class="text-pink-400">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-500 pointer-events-none">
                                <i class="fa-solid fa-microphone-lines"></i>
                            </span>
                            <select asp-for="ArtistId" asp-items="ViewBag.artists" id="albumArtistSelect"
                                    class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-[#121629] border border-white/10 text-sm text-white focus:outline-none focus:border-pink-500/60 focus:ring-2 focus:ring-pink-500/20 transition-all">
                                <option value="">-- Sanatçı Seçiniz --</option>
                            </select>
                        </div>
                        <span asp-validation-for="ArtistId" class="text-xs text-rose-400 font-semibold block"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="ReleaseYear" class="block text-xs font-extrabold uppercase tracking-wider text-slate-300">
                            Çıkış Yılı <span class="text-pink-400">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-500">
                                <i class="fa-solid fa-calendar-days"></i>
                            </span>
                            <input asp-for="ReleaseYear" id="albumYearInput" type="number" placeholder="Örn: 2013"
                                   class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-white/[0.04] border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500/60 focus:ring-2 focus:ring-cyan-500/20 transition-all" />
                        </div>
                        <span asp-validation-for="ReleaseYear" class="text-xs text-rose-400 font-semibold block"></span>
                    </div>
                </div>

                <div class="space-y-2">
                    <label asp-for="CoverImageUrl" class="block text-xs font-extrabold uppercase tracking-wider text-slate-300">
                        Albüm Kapağı (URL)
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-500">
                            <i class="fa-solid fa-image"></i>
                        </span>
                        <input asp-for="CoverImageUrl" id="albumCoverInput" placeholder="https://..."
                               class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-white/[0.04] border border-white/10 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-pink-500/60 focus:ring-2 focus:ring-pink-500/20 transition-all" />
                    </div>
                    <span asp-validation-for="CoverImageUrl" class="text-xs text-rose-400 font-semibold block"></span>
                </div>

                <div class="pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-end gap-3">
                    <a asp-area="Admin" asp-controller="Album" asp-action="Index"
                       class="w-full sm:w-auto px-6 py-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-bold text-slate-300 text-center transition-all">
                        İptal Et
                    </a>
                    <button type="submit"
                            class="w-full sm:w-auto btn-gradient inline-flex items-center justify-center gap-2 px-7 py-3 rounded-2xl text-xs font-extrabold uppercase tracking-wider text-white shadow-[0_0_25px_rgba(236,72,153,0.35)] hover:opacity-95 transition-all">
                        <i class="fa-solid fa-rotate"></i>
                        <span>Değişiklikleri Kaydet</span>
                    </button>
                </div>
            </form>
        </div>

        <div class="p-6 rounded-3xl bg-[#0b0e1c]/90 border border-white/10 backdrop-blur-xl flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-5">
                    <span class="text-[11px] font-extrabold uppercase tracking-wider text-cyan-400">
                        Albüm Kart Önizlemesi
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-white/[0.06] text-[10px] font-bold text-slate-400">
                        ID: #@Model.Id
                    </span>
                </div>

                <div class="p-5 rounded-3xl bg-white/[0.03] border border-white/10 space-y-4">
                    <div class="relative aspect-square w-full max-w-[210px] mx-auto rounded-2xl overflow-hidden border border-white/15 shadow-[0_0_30px_rgba(6,182,212,0.2)]">
                        <img id="previewCover" src="@Model.CoverImageUrl" alt="@Model.Title"
                             class="w-full h-full object-cover @(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "hidden" : "")" />
                        <div id="previewFallback"
                             class="w-full h-full bg-gradient-to-tr from-cyan-500/20 to-pink-500/20 flex items-center justify-center text-4xl text-cyan-400 @(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "" : "hidden")">
                            <i class="fa-solid fa-compact-disc"></i>
                        </div>
                    </div>

                    <div class="text-center space-y-1">
                        <h3 id="previewTitle" class="text-base font-black text-white tracking-tight">
                            @(string.IsNullOrWhiteSpace(Model.Title) ? "Albüm Başlığı" : Model.Title)
                        </h3>
                        <p id="previewArtist" class="text-xs font-bold text-pink-400">
                            Seçili Sanatçı
                        </p>
                        <span id="previewYear" class="inline-block mt-1 px-2.5 py-0.5 rounded-full bg-white/[0.06] text-[10px] font-bold text-slate-300">
                            @Model.ReleaseYear
                        </span>
                    </div>
                </div>
            </div>

            <div class="mt-6 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] text-[11px] text-slate-400 flex items-start gap-2.5">
                <i class="fa-solid fa-circle-info text-cyan-400 mt-0.5"></i>
                <span>Sanatçıyı veya kapak görselini değiştirdiğinizde albüme bağlı tüm şarkıların görünümü otomatik güncellenir.</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const titleInput = document.getElementById('albumTitleInput');
        const artistSelect = document.getElementById('albumArtistSelect');
        const yearInput = document.getElementById('albumYearInput');
        const coverInput = document.getElementById('albumCoverInput');

        const previewTitle = document.getElementById('previewTitle');
        const previewArtist = document.getElementById('previewArtist');
        const previewYear = document.getElementById('previewYear');
        const previewCover = document.getElementById('previewCover');
        const previewFallback = document.getElementById('previewFallback');

        if (artistSelect && artistSelect.value) {
            previewArtist.textContent = artistSelect.options[artistSelect.selectedIndex]?.text || 'Seçili Sanatçı';
        }

        titleInput?.addEventListener('input', (e) => {
            previewTitle.textContent = e.target.value.trim() || 'Albüm Başlığı';
        });

        artistSelect?.addEventListener('change', (e) => {
            const selectedText = e.target.options[e.target.selectedIndex]?.text;
            previewArtist.textContent = e.target.value ? selectedText : 'Sanatçı Seçilmedi';
        });

        yearInput?.addEventListener('input', (e) => {
            previewYear.textContent = e.target.value.trim() || 'Yıl';
        });

        coverInput?.addEventListener('input', (e) => {
            const url = e.target.value.trim();
            if (url) {
                previewCover.src = url;
                previewCover.classList.remove('hidden');
                previewFallback.classList.add('hidden');
            } else {
                previewCover.classList.add('hidden');
                previewFallback.classList.remove('hidden');
            }
        });

        previewCover?.addEventListener('error', () => {
            previewCover.classList.add('hidden');
            previewFallback.classList.remove('hidden');
        });
    </script>
}